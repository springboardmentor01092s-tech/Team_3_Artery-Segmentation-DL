# Copy to .env for local development. Replace every CHANGE_ME value.
# Never commit backend/.env or use these example values outside local development.
POSTGRES_DB=artery_local
POSTGRES_USER=artery_local
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_LOCAL_PASSWORD
DB_HOST=localhost
DB_PORT=5432
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
UPLOAD_DIRECTORY=./storage/uploads
ANALYSIS_OUTPUT_DIRECTORY=./storage/analysis
ANALYSIS_STENOSIS_THRESHOLD=0.20
ANALYSIS_MIN_COMPONENT_AREA=5
ANALYSIS_CPU_THREADS=2
ANALYSIS_TIMEOUT_SECONDS=600
ANALYSIS_WORKER_STARTUP_TIMEOUT_SECONDS=600
ANALYSIS_MAX_RESPONSE_BYTES=536870912
# ML_PYTHON_EXECUTABLE=../ml/.venv/Scripts/python.exe
# ATTENTION_CHECKPOINT_PATH=../ml/checkpoints/best_attention_unet.pt
# UNETPP_CHECKPOINT_PATH=D:/private-models/best_unetpp.pt
ENVIRONMENT=development
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
