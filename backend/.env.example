# Copy to .env for local development. Replace every CHANGE_ME value.
# Never commit backend/.env or use these example values outside local development.
POSTGRES_DB=artery_local
POSTGRES_USER=artery_local
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_LOCAL_PASSWORD
DB_HOST=localhost
DB_PORT=5432
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
UPLOAD_DIRECTORY=./storage/uploads
ENVIRONMENT=development
