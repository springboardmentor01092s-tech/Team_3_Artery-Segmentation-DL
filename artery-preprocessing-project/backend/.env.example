APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-use
DATABASE_URL=sqlite:///./artery_preprocessing.db
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
ANALYSIS_DIR=./analysis
MODEL_CHECKPOINT=./checkpoints/best_stenosis_unet_optimized.pth
# Optional path to the parent directory that contains stenosis/ and syntax/.
ARCADE_ROOT=..\..
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_FILE=./logs/artery-preprocessing.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
